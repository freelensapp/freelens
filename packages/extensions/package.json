{
  "name": "@freelensapp/extensions",
  "version": "2.0.0-0",
  "description": "Freelens - Free IDE for Kubernetes: extensions",
  "homepage": "https://freelens.app",
  "bugs": {
    "url": "https://github.com/freelensapp/freelens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens.git"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "main": "./src/extension-api.ts",
  "types": "./src/extension-api.ts",
  "files": [
    "dist/extension-api.js",
    "dist/extension-api.d.ts",
    "__mocks__/*.ts"
  ],
  "scripts": {
    "build:dist": "pnpm build:dist:declarations && pnpm build:dist:bundle && pnpm build:dist:shim",
    "build:dist:declarations": "node scripts/generate-dts-tsconfig.mjs && tsc -p tsconfig.dts.generated.json",
    "build:dist:bundle": "rollup -c rollup.dts.config.mjs",
    "build:dist:shim": "node scripts/build-shim.mjs",
    "clean:dist": "pnpm dlx rimraf@6.1.3 dist dist-types",
    "prepack": "pnpm build:dist"
  },
  "dependencies": {
    "@ogre-tools/injectable": "catalog:extensions",
    "@ogre-tools/injectable-react": "catalog:extensions",
    "@types/node": "catalog:extensions",
    "@types/react": "catalog:extensions",
    "@xterm/xterm": "catalog:extensions",
    "chart.js": "catalog:extensions",
    "conf": "catalog:extensions",
    "immer": "catalog:extensions",
    "mobx": "catalog:extensions",
    "monaco-editor": "catalog:extensions",
    "react": "catalog:extensions",
    "react-select": "catalog:extensions",
    "react-window": "catalog:extensions",
    "rfc6902": "catalog:extensions",
    "type-fest": "catalog:extensions"
  },
  "devDependencies": {
    "@freelensapp/core": "workspace:^",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "typescript": "catalog:",
    "typescript-plugin-css-modules": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=42.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/extension-api.js",
    "types": "./dist/extension-api.d.ts",
    "exports": {
      ".": {
        "types": "./dist/extension-api.d.ts",
        "default": "./dist/extension-api.js"
      },
      "./package.json": "./package.json"
    }
  },
  "copyright": "© 2024-2026 Freelens Authors",
  "productName": "Freelens extensions"
}
