    "./main": "./src/main/library.ts",
    "./renderer": "./src/renderer/library.ts",
    "./styles": "./src/renderer/components/app.scss",
    "./template.html": "./src/renderer/template.html",
    "./vars.scss": "./src/renderer/components/vars.scss",
    "./fonts": "./src/renderer/fonts"
