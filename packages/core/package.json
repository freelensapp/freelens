      "main": [
        "./src/main/library.ts"
      ],
      "renderer": [
        "./src/renderer/library.ts"
      ]
    }
  },
  "files": [
    "build/*.plist",
    "build/installer.nsh",
    "build/notarize.js",
    "static/build/library/**/*",
    "src/renderer/template.html",
    "src/renderer/components/vars.scss",
    "types/*",
    "tsconfig.json"
  ],
  "scripts": {
    "clean:dist": "pnpm dlx rimraf@6.1.3 dist static/build",
    "test:unit": "TZ=UTC vitest run -c ../../vitest.config.ts --project @freelensapp/core",
    "test:watch": "TZ=UTC vitest -c ../../vitest.config.ts --project @freelensapp/core"
  },
