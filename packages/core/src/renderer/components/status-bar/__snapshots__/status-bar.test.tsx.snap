            class="preventedDragging"
          >
            <div
              class="root"
              data-testid="ai-assistant-top-bar-item"
            >
              <button
                class="ask"
                data-testid="ai-assistant-ask"
                title="Choose an AI assistant"
                type="button"
              >
                <span
                  class="sparkle"
                >
                  ✦
                </span>
                Set up AI
              </button>
              <button
                aria-expanded="false"
                aria-haspopup="menu"
                aria-label="Choose AI assistant"
                class="toggle"
                data-testid="ai-assistant-menu-toggle"
                type="button"
              >
                ▾
              </button>
            </div>
          </div>
        </div>
      </div>
      <main>
        <div
          id="lens-views"
        />
        <div
          class="flex justify-center Welcome items-center"
          data-testid="welcome-page"
        >
          <div
            data-testid="welcome-banner-container"
            style="width: 320px;"
          >
            <svg
              aria-label="ProLens"
              class="logo"
              data-testid="no-welcome-banners-icon"
              height="200"
              role="img"
              viewBox="0 0 400 400"
              width="200"
            >
              <defs>
                <lineargradient
                  id="prolens-logo-background"
                  x1="0"
                  x2="1"
                  y1="0"
                  y2="1"
                >
                  <stop
                    offset="0"
                    stop-color="#3B82F6"
                  />
                  <stop
                    offset="1"
                    stop-color="#8B5CF6"
                  />
                </lineargradient>
                <radialgradient
                  cx="0.3"
                  cy="0.25"
                  id="prolens-logo-glow"
                  r="0.9"
                >
                  <stop
                    offset="0"
                    stop-color="#ffffff"
                    stop-opacity="0.22"
                  />
                  <stop
                    offset="1"
                    stop-color="#ffffff"
                    stop-opacity="0"
                  />
                </radialgradient>
              </defs>
              <rect
                fill="url(#prolens-logo-background)"
                height="384"
                rx="88"
                width="384"
                x="8"
                y="8"
              />
              <rect
                fill="url(#prolens-logo-glow)"
