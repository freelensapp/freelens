                fill-opacity="0.86"
              />
            </svg>
            <div
              class="flex justify-center"
            >
              <div
                data-testid="welcome-text-container"
                style="width: 320px;"
              >
                <h2>
                  Welcome to some-product-name!
                </h2>
                <p>
                  To get you started we have auto-detected your clusters in your kubeconfig file and added them to the catalog, your centralized view for managing all your cloud-native resources.
                  <br />
                  <br />
                  If you have any questions or feedback, please join us on our 
                  <a
                    class="link"
                    href="https://github.com/chago1991/prolens/discussions"
                    rel="noreferrer"
                    target="_blank"
                  >
                    Github repository
                  </a>
                  .
                </p>
                <ul
                  class="block"
                  data-testid="welcome-menu-container"
                  style="width: 320px;"
                >
                  <li
                    class="flex grid-12"
                  >
                    <i
                      class="Icon col-1 material focusable"
                    >
                      <span
                        class="icon"
                        data-icon-name="view_list"
                      >
                        view_list
                      </span>
                    </i>
                    <a
                      class="col-10"
                    >
                      Browse Clusters in Catalog
                    </a>
                    <i
                      class="Icon col-1 material focusable"
                    >
                      <span
                        class="icon"
                        data-icon-name="navigate_next"
                      >
                        navigate_next
                      </span>
                    </i>
                  </li>
                  <li
