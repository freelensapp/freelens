              <path
                d="M189 244L118.09 284.94A118 118 0 0 1 83.24 182.94Z"
                fill="#ffffff"
                fill-opacity="0.86"
              />
              <path
                d="M156.39 212.47L85.49 171.53A118 118 0 0 1 156.39 90.35Z"
