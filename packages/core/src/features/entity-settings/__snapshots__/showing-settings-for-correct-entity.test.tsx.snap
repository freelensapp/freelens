                  data-testid="metrics-tab"
                  role="tab"
                  tabindex="0"
                >
                  <div
                    class="label"
                  >
                    Metrics
                  </div>
                </div>
                <div
                  class="Tab flex gap-2 items-center"
                  data-testid="node-shell-tab"
                  role="tab"
                  tabindex="0"
                >
                  <div
                    class="label"
                  >
                    Node Shell
                  </div>
                </div>
              </div>
            </div>
          </nav>
          <div
            class="contentRegion"
            id="ScrollSpyRoot"
          >
            <div
              class="content"
            >
              <section>
                <h2
                  data-testid="proxy-header"
                >
                  Proxy
                </h2>
                <section>
                  <section>
                    <div
                      class="SubTitle"
                      id="http-proxy"
                    >
                      HTTP Proxy
                       
                    </div>
                    <div
                      class="Input theme round black"
                    >
                      <label
                        class="input-area flex items-center gap-2"
                        id=""
                      >
                        <input
                          class="input grow"
                          placeholder="http://<address>:<port>"
                          spellcheck="false"
                          value=""
                        />
                      </label>
                      <div
                        class="input-info flex gap-2"
                      />
                    </div>
                    <small
                      class="hint"
                    >
                      Proxy for the connections of the views of this cluster to its Kubernetes API. Takes an http://, https:// or socks5:// URL. A proxy-url in the kubeconfig takes precedence. It is also HTTPS_PROXY in the terminal of this cluster. Reconnect the cluster and reopen its terminal after changing it.
                    </small>
                  </section>
                </section>
              </section>
            </div>
            <div
              class="toolsRegion"
            >
              <div
                class="fixed top-[60px]"
              >
                <div>
                  <div
                    aria-label="Close"
                    class="closeButton"
                    role="button"
                  >
                    <i
                      class="Icon icon material focusable"
                    >
                      <span
                        class="icon"
                        data-icon-name="close"
                      >
                        close
                      </span>
                    </i>
                  </div>
                  <div
                    aria-hidden="true"
                    class="esc"
                  >
                    ESC
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <div
        class="HotbarMenu flex flex-col"
      >
        <div
          class="HotbarItems flex flex-col"
        >
          <div
            class="HotbarCell animateDown"
            index="0"
          >
            <div
              aria-describedby="DndDescribedBy-2"
              aria-disabled="false"
              aria-roledescription="draggable"
              role="button"
              style="z-index: 12; position: absolute; opacity: 1; pointer-events: auto;"
              tabindex="0"
            >
              <div
                class="HotbarIcon contextMenuAvailable"
              >
                <div
                  class="Avatar rounded disabled avatar"
                  id="hotbarIcon-hotbar-icon-welcome-page-entity"
                  style="width: 40px; height: 40px; background: rgb(110, 77, 28);"
                >
                  WP
                </div>
              </div>
            </div>
          </div>
          <div
            class="HotbarCell animateDown"
            index="1"
          >
            <div
              aria-describedby="DndDescribedBy-2"
              aria-disabled="false"
              aria-roledescription="draggable"
              role="button"
              style="z-index: 11; position: absolute; opacity: 1; pointer-events: auto;"
              tabindex="0"
            >
              <div
                class="HotbarIcon contextMenuAvailable"
              >
                <div
                  class="Avatar rounded disabled avatar"
                  id="hotbarIcon-hotbar-icon-catalog-entity"
                  style="width: 40px; height: 40px; background: rgb(36, 110, 28);"
                >
                  Ca
                </div>
              </div>
            </div>
          </div>
          <div
            class="HotbarCell animateDown"
            index="2"
          />
          <div
            class="HotbarCell animateDown"
            index="3"
          />
          <div
            class="HotbarCell animateDown"
            index="4"
          />
          <div
            class="HotbarCell animateDown"
            index="5"
          />
          <div
            class="HotbarCell animateDown"
            index="6"
          />
          <div
            class="HotbarCell animateDown"
            index="7"
          />
          <div
            class="HotbarCell animateDown"
            index="8"
          />
          <div
            class="HotbarCell animateDown"
            index="9"
          />
          <div
            class="HotbarCell animateDown"
            index="10"
          />
          <div
            class="HotbarCell animateDown"
            index="11"
          />
          <div
            id="DndDescribedBy-2"
            style="display: none;"
          >
            
    To pick up a draggable item, press the space bar.
    While dragging, use the arrow keys to move the item.
    Press space again to drop the item in its new position, or press escape to cancel.
  
          </div>
