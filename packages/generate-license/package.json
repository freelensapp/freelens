{
  "name": "@nibamot/generate-license",
  "version": "2.0.1",
  "private": true,
  "description": "CLI for generating license files",
  "homepage": "https://github.com/Nibamot/ims-scope",
  "bugs": {
    "url": "https://github.com/Nibamot/ims-scope/issues"
  },
  "repository": {
