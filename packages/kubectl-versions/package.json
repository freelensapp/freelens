{
  "name": "@nibamot/kubectl-versions",
  "version": "2.0.2",
  "private": true,
  "description": "Package of kubectl versions at build time",
  "homepage": "https://github.com/Nibamot/ims-scope",
  "bugs": {
    "url": "https://github.com/Nibamot/ims-scope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nibamot/ims-scope.git"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "ims-scope@ims-scope.app"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "precompute-versions": "tsc --pretty --project build",
    "compute-versions": "node ./build/compute-versions.mjs",
    "preupdate-kubectl-checksums": "pnpm --filter @nibamot/ensure-binaries build",
    "update-kubectl-checksums": "update-kubectl-checksums --versions build/versions.json --checksums build/checksums.json"
  },
  "devDependencies": {
    "@nibamot/ensure-binaries": "workspace:^",
    "@nibamot/typescript": "workspace:^",
    "@types/semver": "catalog:",
    "fast-xml-parser": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
