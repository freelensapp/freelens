{
  "name": "@freelensapp/ensure-binaries",
  "version": "2.0.0-0",
  "private": true,
  "description": "CLI for downloading configured versions of the bundled versions of CLIs",
  "homepage": "https://freelens.app",
  "bugs": {
    "url": "https://github.com/freelensapp/freelens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens.git"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "main": "dist/index.js",
  "bin": {
    "ensure-binaries": "bin/ensure-binaries.js",
    "update-binaries-lock": "bin/update-binaries-lock.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --pretty --project .",
    "build:dev": "tsc --pretty --project .",
    "clean:dist": "pnpm dlx rimraf@6.1.3 dist",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "arg": "catalog:",
    "cli-progress": "catalog:",
    "gunzip-maybe": "catalog:",
    "node-fetch": "catalog:",
    "tar-stream": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cli-progress": "catalog:",
    "@types/gunzip-maybe": "catalog:",
    "@types/node": "catalog:",
    "@types/tar-stream": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
