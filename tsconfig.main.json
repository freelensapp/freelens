{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "types": ["node"]
  },
  "include": [
    "freelens/src/main/**/*",
    "freelens/src/common/**/*",
    "freelens/src/freelens-extension-api.ts",
    "packages/core/src/**/main/**/*",
    "packages/core/src/**/main-api/**/*",
    "packages/core/src/**/common/**/*",
    "packages/core/src/**/common-api/**/*",
    "packages/core/src/features/**/register-injectables.ts",
    "packages/core/src/register-injectables-main.ts",
    "packages/core/src/extensions/api-globals/main-singletons.ts",
    "packages/core/src/extensions/ipc/ipc-main.ts",
    "packages/core/src/extensions/lens-main-extension.ts",
    "packages/core/src/extensions/api-globals/global-name-for-module-id.ts",
    "packages/core/src/extensions/api-globals/global-shape.ts",
    "packages/core/src/extensions/base-extension-store.ts",
    "packages/core/src/extensions/extension-api-di/**/*",
    "packages/core/src/extensions/extension-discovery/**/*",
    "packages/core/src/extensions/extension-installation-state-store/**/*",
    "packages/core/src/extensions/extension-loader/**/*",
    "packages/core/src/extensions/extensions.injectable.ts",
    "packages/core/src/extensions/installed-extension.ts",
    "packages/core/src/extensions/ipc/ipc-registrar.ts",
    "packages/core/src/extensions/lens-extension.ts",
    "packages/core/src/extensions/main-extensions.injectable.ts",
    "packages/core/src/extensions/register-injectables.ts",
    "packages/core/src/extensions/renderer-extensions.injectable.ts",
    "packages/core/types/freelensapp-styles.d.ts",
    "packages/core/types/mocks.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/renderer/**",
    "**/renderer-api/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__mocks__/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/test-env/**",
    "**/test-utils/**",
    "**/*.global-override-for-injectable.ts",
    "**/getDiForUnitTesting.ts",
    "**/getDiForUnitTesting.tsx",
    "packages/core/src/features/cluster/enumeration/common/test-utils.ts",
    "packages/core/src/features/cluster/execute/common/testing.ts"
  ]
}
