{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "entry": [],
  "project": [],

  // vitest is declared as a devDependency in every package with tests: the
  // root vitest.config.ts uses it as the project-discovery marker, and tests
  // written against the enabled globals never import it directly.
  "ignoreDependencies": ["vitest"],

  // Note: several ignoreDependencies entries below (electron for freelens,
  // core, and the technical-feature packages; @freelensapp/core for extensions;
  // react for the button package) are only needed in --production --strict
  // mode, where devDependency imports in production files count as unlisted. In
  // the plain development run these entries look redundant, so knip would report
  // them as removable configuration hints. Since a single config must satisfy
  // both runs, the shared knip script runs with --no-config-hints (see the
  // "knip" script in package.json) to silence those unavoidable hints.

  // The unused-file check of the development pass (see "knip:development" in
  // package.json) runs with --no-gitignore, which the dependency check needs
  // for freelens/static/build/main.js, so it also sees what git ignores.
  "ignore": [
    // Generated by `pnpm build:di` for every directory with injectables, and
    // not imported by any root registration. Removing them would only make the
    // generator write them again.
    "packages/core/src/features/register-injectables.ts",
    "packages/core/src/test-env/register-injectables.ts",
    "packages/technical-features/messaging/messaging/src/register-injectables.ts",
    // Local artifacts of the Playwright and Electron MCP servers and of
    // `vitest --coverage`, which never exist in CI.
    ".playwright-mcp/**",
    "logs/**",
    "**/coverage/**"
  ],

  "workspaces": {
    ".": {
      "entry": [
        // the electron alias of every project except core in vitest.config.ts,
        // which builds the path with join() where knip cannot see it
        "vitest.electron-stub.ts",
        // probes compiled by `type:check:environments` only, with no importer
        "scripts/type-check-environments/expected-failures/**/*.ts"
      ],
      // Trunk runs SVGO, so no dependency turns on the plugin that finds
      // svgo.config.js.
      "svgo": true,
      // Binaries the workflows and scripts call that no dependency provides:
      // jq comes with the runner image, yq from mise (see mise.toml), the rest
      // from the operating system.
      "ignoreBinaries": [".*Freelens.exe", "jq", "open", "powershell", "xdg-open", "yq"],
      "ignoreDependencies": [
        // used to run pnpm in monorepo workspaces from the root
        "pnpm"
      ],
      "ignoreUnresolved": [
        // vitest.config.ts wires per-project setup files and the canvas mock;
        // they resolve relative to each project dir (packages/core), not to
        // the root config
        "./src/vitest.setup.tsx",
        "./src/vitest-after-env.setup.ts",
        "vitest-canvas-mock"
      ]
    },

    // knip runs after `pnpm build` (see .github/workflows/knip.yaml): the
    // bundled static/build/main.js is scanned through the package.json main
    // field, which is how the third-party packages externalized from the ESM
    // main bundle by electron-vite's externalizeDepsPlugin are detected as
    // used dependencies.
    "freelens": {
      "entry": [
        "build/notarize.cjs",
        "electron.vite.config.ts",
        "integration/**/*.tests.ts",
        // the renderer is fully bundled at build time, so only the main
        // process side is the production surface: its bundle's imports must
        // stay installable in the packaged app, while renderer imports may be
        // devDependencies
        "src/main/index.ts!",
        "src/renderer/index.ts",
        // the ambient type of the FreelensExtensionApi global: tsconfig.json
        // includes it, and nothing imports it
        "src/freelens-extension-api.ts!",
        // the config of the test:integration script, passed with --config
        "vitest.integration.config.ts"
      ],
      "project": [
        "*.ts",
        "build/*.cjs",
        "integration/**/*.ts",
        "src/**/*.ts",
        "src/common/**/*.ts!",
        "src/freelens-extension-api.ts!",
        "src/main/**/*.ts!"
      ],
      // the electron-vite plugin turns every input of electron.vite.config.ts
      // into a production entry, the renderer included, which would demand
      // the renderer's devDependencies be dependencies; the entries above
      // already cover the config and its inputs
      "electron-vite": false,
      "ignoreBinaries": ["distwin-unpackedFreelens.exe"],
      "ignoreDependencies": [
        // imported by the bundled static/build/main.js but declared as a
        // devDependency so electron-builder does not pack it into the app
        "electron",
        // explicit dependency to prevent to install different versions of app-build-lib
        "electron-builder-squirrel-windows"
      ],
      "typescript": {
        "config": ["tsconfig.json"]
      }
    },

    "packages/core": {
      "entry": [
        "src/{main,renderer}/library.ts!",
        // type-only assertions over the extension-API namespaces: `pnpm
        // type:check` compiles them and nothing imports them, which is the
        // point — see the file's header
        "src/extensions/__tests__/extension-api.types.ts",
        // app.scss loads it with `@include meta.load-css("fonts")`, which knip
        // does not follow as it does `@use` and `@import`
        "src/renderer/components/fonts.scss!"
      ],
      "project": ["__mocks__/**/*.{ts,tsx}", "src/**/*.{css,scss,ts,tsx}!", "types/*.d.ts"],
      "ignoreDependencies": [
        // static YAML templates imported with a relative import.meta.glob in
        // lens-templates.injectable.ts, invisible to the module resolver
        "@freelensapp/resource-templates",
        // provided by the Electron runtime and declared only as a
        // devDependency; production code imports it in both processes
        "electron",
        // tailwind dependencies are not handled by knip correctly
        "@tailwindcss/postcss",
        "tailwindcss"
      ],
      "typescript": {
        "config": ["tsconfig.json"]
      }
    },

    "packages/ensure-binaries": {
      // the sources of the update-binaries-lock and update-kubectl-checksums
      // bins: bin/*.js import them from dist/, which exists only after a build
      "entry": ["src/update-kubectl-checksums.ts!", "src/update-lock.ts!"],
      "project": ["bin/*.js!", "src/*.ts!"],
      "typescript": {
        "config": ["tsconfig.json"]
      }
    },

    "packages/extensions": {
      "entry": ["rolldown.dts.config.mjs", "scripts/*.mjs", "src/runtime-shim.ts!"],
      "project": ["*.mjs", "scripts/*.mjs", "src/**/*.ts!"],
      // build:dist output: the bundled declarations inline the types of the
      // whole workspace, so scanning them reports every transitive import of
      // core as an unlisted dependency of this package
      "ignore": ["dist/**", "dist-types/**"],
      "ignoreDependencies": [
        // the workspace entry re-exports core's API namespaces, but core is a
        // devDependency by design: the published package inlines all core
        // types into the bundled d.ts and consumes the runtime global instead
        "@freelensapp/core",
        // optional peerDependency, referenced by the bundled d.ts for the
        // Electron types it inlines
        "electron",
        // type-level dependencies of the published bundled extension-api.d.ts:
        // extension projects resolve these packages for types through
        // @freelensapp/extensions, so they must stay declared even though no
        // runtime code in this package imports them
        "@types/react",
        "@types/react-dom",
        "@types/react-window",
        "@xterm/xterm",
        "chart.js",
        "conf",
        "es-toolkit",
        "immer",
        "mobx",
        "mobx-react",
        "monaco-editor",
        "react",
        "react-dom",
        "react-select",
        "react-window",
        "rfc6902",
        "type-fest"
      ],
      "typescript": {
        "config": ["tsconfig.json", "tsconfig.dts.json"]
      }
    },

    // The contract fixture is an extension, not a library: its entrypoints are
    // the `main` and `renderer` manifest fields, which point at build output,
    // and knip does not read `renderer` at all, so they are listed below.
    "packages/fixture-extension": {
      "entry": [
        "vite.config.mjs",
        // type-only by design: the type level of the contract, with no runtime
        // importer here or anywhere else
        "src/common/contract-types.ts!",
        "src/common/v1-renames.ts!",
        "src/main/index.ts!",
        "src/renderer/index.tsx!"
      ],
      "project": ["*.mjs", "src/**/*.{css,scss,ts,tsx}!"],
      // build output: one self-contained bundle in which every import has been
      // replaced by a read of the host global, so there is nothing to resolve
      "ignore": ["dist/**"],
      // The Vite plugin adds the renderer entry of vite.config.mjs as an entry
      // of its own, which is not a production one, and it replaces the
      // `src/renderer/index.tsx!` above: the --production pass would then skip
      // the whole renderer. vite.config.mjs is listed as an entry instead.
      "vite": false,
      "ignoreDependencies": [
        // host-provided modules. The bundle maps them onto
        // globalThis.FreelensExtensionApi (see vite.config.mjs), and Freelens
        // installs no dependencies of an extension, so they are declared as
        // devDependencies for their types alone, which the --production
        // --strict pass reports as unlisted
        "@freelensapp/extensions",
        "@types/react",
        "mobx",
        "react"
      ],
      "typescript": {
        // one program per runtime environment, and one for vite.config.mjs
        "config": ["src/main/tsconfig.json", "src/renderer/tsconfig.json", "src/common/tsconfig.json", "tsconfig.json"]
      }
    },

    "packages/generate-tray-icons": {
      "project": ["bin/*.js!", "src/*.ts!"],
      "ignoreDependencies": [
        // source of the tray icon SVGs passed on the command line
        "@freelensapp/icon"
      ],
      "typescript": {
        "config": ["tsconfig.json"]
      }
    },

    "packages/resource-templates": {
      "entry": [],
      "project": []
    },

    "packages/semver": {
      // build output: nothing imports the compiled CLI, so the file check
      // reports it once a build has run
      "ignore": ["dist/**"]
    },

    "packages/ui-components/button": {
      // JSX compiles to react/jsx-runtime under the automatic runtime, which
      // knip's --production --strict pass does not attribute to `react`. The
      // only explicit react import here is type-only (ButtonHTMLAttributes),
      // so react looks unused even though it is a real runtime dependency.
      "ignoreDependencies": ["react"]
    },

    // electron is provided by the host app at runtime, so it is declared only
    // as a devDependency; production code in these packages imports it, which
    // the --production --strict pass reports as unlisted (same as freelens and
    // packages/core above)
    "packages/technical-features/application/application-for-electron-main": {
      "ignoreDependencies": ["electron"]
    },

    "packages/technical-features/messaging/messaging-for-main": {
      "ignoreDependencies": ["electron"]
    },

    "packages/technical-features/messaging/messaging-for-renderer": {
      "ignoreDependencies": ["electron"]
    }
  },

  "exclude": ["exports"]
}
